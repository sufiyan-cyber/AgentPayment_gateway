# ==============================================================================
# MandateSentinel Environment Configuration
# ==============================================================================

# Application
APP_NAME=MandateSentinel
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL for Docker, or SQLite for instant local dev)
DATABASE_URL=postgresql://sentinel:sentinel_password_123@localhost:5432/mandatesentinel
# Local zero-setup SQLite alternative:
# DATABASE_URL=sqlite:///./mandatesentinel.db

# Redis State & Session Velocity (Optional - falls back to sub-microsecond in-memory)
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (NEVER USE LIVE KEYS)
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_mandate_sentinel_mock
RAZORPAY_KEY_SECRET=mock_secret_key_12345
RAZORPAY_MOCK_MODE=true

# Anthropic Claude API (Optional - for advanced LLM audit reasoning)
ANTHROPIC_API_KEY=

# Risk Model Thresholds (Calibrated on training split)
T_STEPUP=0.45
T_BLOCK=0.70

# Feature Weights: w1*(1-semantic) + w2*iforest + w3*velocity + w4*spend
WEIGHT_SEMANTIC=0.40
WEIGHT_ANOMALY=0.25
WEIGHT_VELOCITY=0.15
WEIGHT_SPEND=0.20
